{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Critic Verdict",
  "type": "object",
  "required": [
    "claim_as_adjudicated",
    "correction_applied",
    "divergence",
    "level",
    "level_name",
    "verdict",
    "citations",
    "what_would_change_this",
    "gate",
    "gate_condition",
    "scaffold"
  ],
  "properties": {
    "claim_as_adjudicated": { "type": "string" },
    "correction_applied": { "type": ["string", "null"] },
    "divergence": {
      "type": "object",
      "required": ["P", "S", "W", "A", "D"],
      "properties": {
        "P": { "$ref": "#/$defs/axis" },
        "S": { "$ref": "#/$defs/axis" },
        "W": { "$ref": "#/$defs/axis" },
        "A": { "$ref": "#/$defs/axis" },
        "D": { "type": "integer", "minimum": 0, "maximum": 12 }
      }
    },
    "level": { "type": "integer", "minimum": 0, "maximum": 5 },
    "level_name": {
      "type": "string",
      "enum": ["affirm", "correct", "challenge", "adjudicate", "scathing", "terminal"]
    },
    "verdict": { "type": "string" },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["locator", "quote", "page", "pagination_status", "apa", "resolved"],
        "properties": {
          "locator": { "type": "string" },
          "quote": { "type": "string" },
          "page": { "type": ["integer", "null"] },
          "pagination_status": { "type": "string", "enum": ["pending", "complete"] },
          "apa": { "type": "string" },
          "resolved": { "type": "boolean" }
        }
      }
    },
    "what_would_change_this": { "type": ["string", "null"] },
    "gate": {
      "type": "string",
      "enum": ["ALLOW", "CONDITIONAL", "DENY", "ESCALATE"]
    },
    "gate_condition": { "type": ["string", "null"] },
    "scaffold": { "type": "string" }
  },
  "$defs": {
    "axis": {
      "type": "object",
      "required": ["score", "why"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 3 },
        "why": { "type": "string" }
      }
    }
  }
}
